#!/usr/bin/env python3
"""
Minimal Chess Inheritance / Latent Memory Falsification Test
============================================================
Implements a stripped-down version of the four-group experiment from
"Intelligence as Accumulated Structure".

Core claim tested:
  A compressed latent representation extracted from an experienced agent
  can give a new agent a measurable head-start under matched compute.

Groups:
  A - Novice (minimal training)
  B - Experienced (more training, no persistent latent memory)
  C - Latent Memory (persistent latent state updated during training)
  D - Inherited (fresh agent initialized from compressed latent of C)

Controls for falsification:
  - Scrambled inheritance (structure destroyed, magnitude preserved)
  - Ablation of latent memory
  - Matched data exposure

This is deliberately minimal so it can run in minutes on CPU.
Results are for demonstration / protocol validation, not publication-grade.
"""

import chess
import chess.engine
import torch
import torch.nn as nn
import torch.nn.functional as F
import numpy as np
from collections import defaultdict
import random
import time
from pathlib import Path

# ----------------------- Config (kept tiny for speed) -----------------------
DEVICE = "cpu"
BOARD_SIZE = 8
N_CHANNELS = 12          # 6 piece types x 2 colors
LATENT_DIM = 32
HIDDEN = 64
LR = 1e-3
GAMES_PER_AGENT = 12     # extremely small for speed on CPU
EVAL_POSITIONS = 12
STOCKFISH_PATH = "/usr/games/stockfish"
STOCKFISH_DEPTH = 4      # low depth for speed
SEED = 42

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

# ----------------------- Board encoding ------------------------------------
def board_to_tensor(board: chess.Board) -> torch.Tensor:
    """12-plane binary encoding of the board."""
    planes = np.zeros((N_CHANNELS, 8, 8), dtype=np.float32)
    piece_map = {
        chess.PAWN: 0, chess.KNIGHT: 1, chess.BISHOP: 2,
        chess.ROOK: 3, chess.QUEEN: 4, chess.KING: 5
    }
    for sq in chess.SQUARES:
        piece = board.piece_at(sq)
        if piece is None:
            continue
        plane = piece_map[piece.piece_type]
        if piece.color == chess.BLACK:
            plane += 6
        r, c = divmod(sq, 8)
        planes[plane, r, c] = 1.0
    return torch.from_numpy(planes)

# ----------------------- Simple policy/value + latent memory ---------------
class TinyChessNet(nn.Module):
    def __init__(self, use_latent=False, latent_dim=LATENT_DIM):
        super().__init__()
        self.use_latent = use_latent
        self.latent_dim = latent_dim

        self.conv = nn.Sequential(
            nn.Conv2d(N_CHANNELS, 16, 3, padding=1),
            nn.ReLU(),
            nn.Conv2d(16, 16, 3, padding=1),
            nn.ReLU(),
            nn.Flatten()
        )
        flat = 16 * 8 * 8
        self.fc = nn.Sequential(
            nn.Linear(flat + (latent_dim if use_latent else 0), HIDDEN),
            nn.ReLU(),
            nn.Linear(HIDDEN, HIDDEN),
            nn.ReLU()
        )
        self.policy_head = nn.Linear(HIDDEN, 4672)  # rough legal-move upper bound
        self.value_head = nn.Linear(HIDDEN, 1)

        if use_latent:
            # Persistent latent memory (simple gated update)
            self.latent = nn.Parameter(torch.zeros(1, latent_dim))
            self.latent_update = nn.Linear(HIDDEN + latent_dim, latent_dim)

    def forward(self, x, update_latent=False):
        h = self.conv(x)
        if self.use_latent:
            lat = self.latent.expand(x.size(0), -1)
            h = torch.cat([h, lat], dim=1)
        h = self.fc(h)
        policy = self.policy_head(h)
        value = torch.tanh(self.value_head(h))

        if self.use_latent and update_latent and self.training:
            with torch.no_grad():
                new_lat = torch.tanh(self.latent_update(torch.cat([h.mean(0, keepdim=True), self.latent], dim=1)))
                self.latent.data = 0.9 * self.latent.data + 0.1 * new_lat  # slow EMA-style update
        return policy, value

    def get_latent(self):
        if self.use_latent:
            return self.latent.detach().clone()
        return None

    def set_latent(self, z):
        if self.use_latent and z is not None:
            self.latent.data = z.clone()

# ----------------------- Helpers -------------------------------------------
def legal_move_mask(board, device):
    mask = torch.zeros(4672, device=device)
    for move in board.legal_moves:
        # crude mapping: from*64 + to  (ignores promotion for simplicity)
        idx = move.from_square * 64 + move.to_square
        if idx < 4672:
            mask[idx] = 1.0
    return mask

def select_move(net, board, temperature=1.0):
    net.eval()
    with torch.no_grad():
        x = board_to_tensor(board).unsqueeze(0).to(DEVICE)
        logits, value = net(x)
        mask = legal_move_mask(board, DEVICE)
        logits = logits.squeeze(0)
        logits = logits.masked_fill(mask == 0, -1e9)
        probs = F.softmax(logits / max(temperature, 1e-5), dim=0)
        move_idx = torch.multinomial(probs, 1).item()
        from_sq = move_idx // 64
        to_sq = move_idx % 64
        for m in board.legal_moves:
            if m.from_square == from_sq and m.to_square == to_sq:
                return m, value.item()
        # fallback
        return random.choice(list(board.legal_moves)), value.item()

def play_game(net, opponent="random", max_moves=60):
    board = chess.Board()
    result = 0.0  # from White's perspective
    moves = 0
    while not board.is_game_over() and moves < max_moves:
        if board.turn == chess.WHITE:
            move, _ = select_move(net, board, temperature=0.8)
        else:
            if opponent == "random":
                move = random.choice(list(board.legal_moves))
            else:
                move, _ = select_move(net, board, temperature=1.0)
        board.push(move)
        moves += 1
    if board.is_checkmate():
        result = 1.0 if board.turn == chess.BLACK else -1.0  # side that just moved won
    elif board.is_stalemate() or board.is_insufficient_material():
        result = 0.0
    return result, moves

def train_agent(net, n_games, use_latent_update=False, label=""):
    opt = torch.optim.Adam(net.parameters(), lr=LR)
    losses = []
    for g in range(n_games):
        board = chess.Board()
        states, values, rewards = [], [], []
        while not board.is_game_over() and len(states) < 40:
            x = board_to_tensor(board).unsqueeze(0).to(DEVICE)
            logits, value = net(x, update_latent=use_latent_update)
            mask = legal_move_mask(board, DEVICE)
            logits = logits.squeeze(0).masked_fill(mask == 0, -1e9)
            probs = F.softmax(logits, dim=0)
            move_idx = torch.multinomial(probs, 1).item()
            from_sq = move_idx // 64
            to_sq = move_idx % 64
            move = None
            for m in board.legal_moves:
                if m.from_square == from_sq and m.to_square == to_sq:
                    move = m
                    break
            if move is None:
                move = random.choice(list(board.legal_moves))
            states.append(x)
            values.append(value)
            board.push(move)
            if board.is_game_over():
                break
        # simple terminal reward
        if board.is_checkmate():
            r = 1.0 if board.turn == chess.BLACK else -1.0
        else:
            r = 0.0
        # backprop value loss only (policy is exploratory)
        loss = 0.0
        for v in values:
            loss = loss + (v - r) ** 2
        if len(values) > 0:
            loss = loss / len(values)
            opt.zero_grad()
            loss.backward()
            opt.step()
            losses.append(loss.item())
        if (g + 1) % 10 == 0:
            print(f"  [{label}] game {g+1}/{n_games}  avg_loss={np.mean(losses[-10:]):.4f}")
    return net

def evaluate_vs_stockfish(net, n_pos=EVAL_POSITIONS):
    """Return average value estimate and rough 'competence' proxy (correlation with Stockfish)."""
    engine = chess.engine.SimpleEngine.popen_uci(STOCKFISH_PATH)
    engine.configure({"Threads": 1})
    scores = []
    net.eval()
    board = chess.Board()
    for i in range(n_pos):
        # generate a semi-random mid-game position
        b = chess.Board()
        for _ in range(random.randint(8, 20)):
            if b.is_game_over():
                break
            b.push(random.choice(list(b.legal_moves)))
        if b.is_game_over():
            continue
        x = board_to_tensor(b).unsqueeze(0).to(DEVICE)
        with torch.no_grad():
            _, value = net(x)
        try:
            info = engine.analyse(b, chess.engine.Limit(depth=STOCKFISH_DEPTH))
            sf_score = info["score"].white().score(mate_score=10000)
            if sf_score is None:
                sf_score = 0
            # normalize roughly
            sf_norm = np.tanh(sf_score / 300.0)
            scores.append((value.item(), sf_norm))
        except Exception:
            continue
    engine.quit()
    if not scores:
        return 0.0, 0.0
    vals, sfs = zip(*scores)
    corr = np.corrcoef(vals, sfs)[0, 1] if len(vals) > 2 else 0.0
    mean_abs_err = np.mean(np.abs(np.array(vals) - np.array(sfs)))
    return float(corr), float(mean_abs_err)

def compress_latent(z, noise=0.0):
    """Simple compression: just the latent vector itself (already small)."""
    if z is None:
        return None
    z = z.clone()
    if noise > 0:
        z = z + noise * torch.randn_like(z)
    return z

def scramble(z):
    """Destroy structure while preserving approximate magnitude."""
    if z is None:
        return None
    # Simple structure-destroying transform: random permutation + sign flips
    z = z.clone().view(-1)
    perm = torch.randperm(z.numel())
    z = z[perm]
    signs = torch.randint(0, 2, z.shape, device=z.device).float() * 2 - 1
    z = z * signs
    # re-scale to original norm
    orig_norm = z.norm() + 1e-8
    z = z * (z.norm() / orig_norm)  # already same, but keep shape
    return z.view(1, -1) if z.dim() == 1 else z

# ----------------------- Main experiment -----------------------------------
def main():
    print("=" * 60)
    print("MINIMAL CHESS INHERITANCE / LATENT-MEMORY FALSIFICATION TEST")
    print("=" * 60)
    print(f"Device: {DEVICE} | Latent dim: {LATENT_DIM} | Games/agent: {GAMES_PER_AGENT}")
    print()

    results = {}

    # ---- Group A: Novice (very few games) ----
    print("[A] Training Novice ...")
    net_A = TinyChessNet(use_latent=False).to(DEVICE)
    train_agent(net_A, n_games=max(5, GAMES_PER_AGENT // 4), label="A-Novice")
    corr_A, mae_A = evaluate_vs_stockfish(net_A)
    results["A_Novice"] = {"corr": corr_A, "mae": mae_A}
    print(f"  → corr(SF)={corr_A:.3f}  MAE={mae_A:.3f}\n")

    # ---- Group B: Experienced (more games, no latent) ----
    print("[B] Training Experienced (no persistent latent) ...")
    net_B = TinyChessNet(use_latent=False).to(DEVICE)
    train_agent(net_B, n_games=GAMES_PER_AGENT, label="B-Experienced")
    corr_B, mae_B = evaluate_vs_stockfish(net_B)
    results["B_Experienced"] = {"corr": corr_B, "mae": mae_B}
    print(f"  → corr(SF)={corr_B:.3f}  MAE={mae_B:.3f}\n")

    # ---- Group C: Latent Memory ----
    print("[C] Training Latent-Memory agent ...")
    net_C = TinyChessNet(use_latent=True).to(DEVICE)
    train_agent(net_C, n_games=GAMES_PER_AGENT, use_latent_update=True, label="C-Latent")
    corr_C, mae_C = evaluate_vs_stockfish(net_C)
    results["C_Latent"] = {"corr": corr_C, "mae": mae_C, "latent_norm": net_C.get_latent().norm().item()}
    print(f"  → corr(SF)={corr_C:.3f}  MAE={mae_C:.3f}  ||Z||={results['C_Latent']['latent_norm']:.3f}\n")

    # Extract and compress latent
    Z_C = net_C.get_latent()
    Z_compressed = compress_latent(Z_C)
    Z_scrambled = scramble(Z_C)

    # ---- Group D: Inherited ----
    print("[D] Training Inherited agent (initialized from C's latent) ...")
    net_D = TinyChessNet(use_latent=True).to(DEVICE)
    net_D.set_latent(Z_compressed)
    # Give it the SAME number of games as a matched control would get,
    # but start with the inherited structure.
    train_agent(net_D, n_games=GAMES_PER_AGENT // 2, use_latent_update=True, label="D-Inherited")
    corr_D, mae_D = evaluate_vs_stockfish(net_D)
    results["D_Inherited"] = {"corr": corr_D, "mae": mae_D}
    print(f"  → corr(SF)={corr_D:.3f}  MAE={mae_D:.3f}\n")

    # ---- Control: Scrambled inheritance ----
    print("[D-scramble] Control: same protocol but scrambled latent ...")
    net_Ds = TinyChessNet(use_latent=True).to(DEVICE)
    net_Ds.set_latent(Z_scrambled)
    train_agent(net_Ds, n_games=GAMES_PER_AGENT // 2, use_latent_update=True, label="D-Scramble")
    corr_Ds, mae_Ds = evaluate_vs_stockfish(net_Ds)
    results["D_Scrambled"] = {"corr": corr_Ds, "mae": mae_Ds}
    print(f"  → corr(SF)={corr_Ds:.3f}  MAE={mae_Ds:.3f}\n")

    # ---- Ablation of C ----
    print("[C-ablate] Ablating latent of C and re-evaluating ...")
    net_C.set_latent(torch.zeros_like(Z_C))
    corr_Ca, mae_Ca = evaluate_vs_stockfish(net_C)
    results["C_Ablated"] = {"corr": corr_Ca, "mae": mae_Ca}
    print(f"  → corr(SF)={corr_Ca:.3f}  MAE={mae_Ca:.3f}\n")

    # ----------------------- Summary & Interpretation -----------------------
    print("=" * 60)
    print("RESULTS SUMMARY")
    print("=" * 60)
    for k, v in results.items():
        print(f"  {k:15s}  corr={v['corr']:+.3f}  MAE={v['mae']:.3f}")

    print("\n" + "-" * 60)
    print("FALSIFICATION / FEASIBILITY READING (this tiny run)")
    print("-" * 60)

    # Simple decision rules (illustrative only)
    transfer_gain = results["D_Inherited"]["corr"] - results["D_Scrambled"]["corr"]
    ablation_drop = results["C_Latent"]["corr"] - results["C_Ablated"]["corr"]

    print(f"  Transfer gain (real vs scrambled): {transfer_gain:+.3f}")
    print(f"  Ablation drop (C latent present vs zeroed): {ablation_drop:+.3f}")

    if transfer_gain > 0.05 and ablation_drop > 0.02:
        print("\n  → PRELIMINARY SUPPORT: inherited structure appears to help")
        print("    more than a magnitude-matched scramble, and ablation hurts.")
        print("    (Still needs many more seeds, longer training, stronger baselines.)")
    elif abs(transfer_gain) < 0.03 and abs(ablation_drop) < 0.02:
        print("\n  → PRELIMINARY FALSIFICATION SIGNAL: no clear advantage from")
        print("    the transferred latent over scramble, and ablation has little effect.")
        print("    The compressed representation did not carry useful predictive structure")
        print("    under these conditions.")
    else:
        print("\n  → INCONCLUSIVE with this tiny compute budget.")
        print("    Need more games, better architecture, or higher evaluation depth.")

    print("\nNote: This is a protocol demonstration. Real conclusions require")
    print("pre-registered thresholds, many random seeds, distribution-shift tests,")
    print("and comparison against distillation / weight-copy baselines.")
    print("=" * 60)

if __name__ == "__main__":
    main()
